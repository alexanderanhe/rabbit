{
  "name": "timer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "react-router build",
    "deploy:build": "npm run build && npm run services:sync:prod",
    "dev": "react-router dev",
    "start": "dotenv -e .env.production -- react-router-serve ./build/server/index.js",
    "test": "node --import tsx --test app/services/health.server.test.ts",
    "worker": "dotenv -e .env -- tsx app/workers/push-worker.ts",
    "worker:prod": "node --env-file=.env.production --import tsx app/workers/push-worker.ts",
    "services:sync:prod": "node --env-file=.env.production scripts/run-production-services.mjs",
    "vapid:generate": "web-push generate-vapid-keys --json",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "bullmq": "^6.1.0",
    "ioredis": "^5.11.1",
    "isbot": "^5.1.36",
    "mongodb": "^7.5.0",
    "nanoid": "^3.3.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "resend": "^6.19.0",
    "tsx": "^4.23.12",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
