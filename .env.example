# MongoDB stores anonymous timers and push subscriptions.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=carrot_timer

# Redis stores BullMQ delayed jobs.
REDIS_URL=redis://127.0.0.1:6379/0

# Generate once with: pnpm web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional worker concurrency.
PUSH_WORKER_CONCURRENCY=10

# A long random value used to sign the session cookie.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Resend delivers registration and sign-in verification codes.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Rabbit Timer <timer@example.com>
